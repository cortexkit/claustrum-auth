{
  "name": "@cortexkit/opencode-claustrum-auth",
  "version": "0.0.0",
  "description": "Claustrum vault credentials for OpenCode 1 and OpenCode 2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortexkit/claustrum-auth.git",
    "directory": "packages/opencode"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts opencode && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@cortexkit/common-auth": "^0.26.0",
    "@cortexkit/claustrum-client": "^0.13.0",
    "@cortexkit/subc-client": "^0.22.10",
    "@cortexkit/private-files": "^0.2.1"
  },
  "devDependencies": {
    "@cortexkit/claustrum-auth-core": "workspace:*"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode/plugin": ">=2.0.21"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  }
}
