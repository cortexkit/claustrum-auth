{
  "name": "@cortexkit/pi-claustrum-auth",
  "version": "0.0.0",
  "description": "Claustrum vault credentials for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortexkit/claustrum-auth.git",
    "directory": "packages/pi"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@cortexkit/claustrum-client": "^0.13.0",
    "@cortexkit/common-auth": "^0.28.0",
    "@cortexkit/private-files": "^0.2.1",
    "@cortexkit/subc-client": "^0.22.10"
  },
  "devDependencies": {
    "@cortexkit/claustrum-auth-core": "workspace:*",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  }
}
